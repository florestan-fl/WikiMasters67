{
  "manifest_version": 3,
  "name": "WikiMasters Trading",
  "version": "2.0.0",
  "description": "Suivez vos achats et ventes sur le marché WikiMasters : profit par jour, stock, statistiques par carte, export Google Sheets.",
  "browser_specific_settings": {
    "gecko": {
      "id": "wikimasters-sheets-sync@wikimasters67",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["storage", "scripting", "unlimitedStorage"],
  "host_permissions": [
    "https://www.wiki-masters.com/*",
    "https://wiki-masters.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "scripts": ["lib/extract.js", "lib/time.js", "lib/settings.js", "lib/store.js", "lib/stats.js", "lib/tables.js", "background.js"]
  },
  "action": {
    "default_title": "WikiMasters Trading",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
