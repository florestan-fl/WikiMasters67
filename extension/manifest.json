{
  "manifest_version": 3,
  "name": "WikiMasters Trading",
  "version": "3.3.1",
  "description": "Suivez vos achats et ventes sur le marché WikiMasters et les prix du marché : profit par jour, stock, statistiques, export Google Sheets. Lecture passive des pages du jeu ; relevé automatique des prix finaux en option.",
  "browser_specific_settings": {
    "gecko": {
      "id": "wikimasters-sheets-sync@wikimasters67",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "webRequest", "webRequestBlocking", "webRequestFilterResponse"],
  "optional_permissions": ["scripting", "notifications"],
  "host_permissions": [
    "https://www.wiki-masters.com/*",
    "https://wiki-masters.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "scripts": ["lib/extract.js", "lib/time.js", "lib/settings.js", "lib/store.js", "lib/market.js", "lib/stats.js", "lib/tables.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["content/site.js"],
      "css": ["content/site.css", "content/fullart.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "WikiMasters Trading",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon-96.png"
  }
}
